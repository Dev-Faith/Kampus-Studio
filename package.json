{
  "name": "nest-playground",
  "version": "1.0.0",
  "description": "A NestJS playground for practising backend concepts: auth, guards, interceptors, pipes, rate limiting, caching, events, websockets and more.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "sync:web": "node scripts/sync-web-public.js",
    "dev:web": "node scripts/sync-web-public.js && npm --prefix web run dev",
    "build:web": "node scripts/sync-web-public.js && npm --prefix web run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.9",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.16.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.9",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
