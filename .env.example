# Copy to `.env` and tweak. Every value has a dev-friendly default, so .env is optional locally.
NODE_ENV=development
PORT=3000

# SQLite (sql.js) file. Use ":memory:" for a throwaway database.
DATABASE_PATH=data/playground.sqlite

# JWT - CHANGE THESE outside of local development (required when NODE_ENV=production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Global rate limit: LIMIT requests per TTL (milliseconds) per IP
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Static key for the API-key guard demo (send it as the `x-api-key` header)
API_KEY=playground-key

# Seeded on first boot when the users table is empty
ADMIN_EMAIL=admin@playground.dev
ADMIN_PASSWORD=Admin123!

# DI lab: switch which Greeter implementation is provided (friendly | formal)
GREETER=friendly

# Optional: Google Gemini API Key for the Kampus Context-Aware AI Tutor
GEMINI_API_KEY=
